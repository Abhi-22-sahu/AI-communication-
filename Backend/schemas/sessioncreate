from datetime import datetime
from typing import Literal

from pydantic import BaseModel


class SessionCreate(BaseModel):
    session_type: Literal[
        "conversation",
        "speaking",
        "interview"
    ]

    scenario: str

    input_type: Literal[
        "text",
        "voice"
    ]


class SessionResponse(BaseModel):
    id: int
    session_type: str
    scenario: str
    input_type: str
    status: str
    started_at: datetime